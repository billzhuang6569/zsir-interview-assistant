<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ZSirCapture.EdgeWindow" Style="{StaticResource {x:Type Window}}" Foreground="{StaticResource Ink}" Title="正在录制 · 点击展开" Width="30" Height="40" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual">
  <Button x:Name="RevealButton" TextElement.Foreground="{StaticResource Ink}" Width="30" Height="40" Padding="0" AutomationProperties.Name="展开录制窗口" Click="RevealClick">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="20,0,0,20" Background="#EB14151A" BorderThickness="1" BorderBrush="Transparent">
          <Grid Tag="overlay">
            <Ellipse Width="20" Height="20" Fill="#40EF6A3A"/>
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource Accent}"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHi}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>
  </Button>
</Window>
