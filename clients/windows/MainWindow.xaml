<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:ZSirCapture" x:Class="ZSirCapture.MainWindow" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{StaticResource Ink}" Title="庄Sir采访录制助手" Width="336" SizeToContent="Height" WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="Manual" Background="{StaticResource Window}">
  <!-- DWM owns Win11 rounding; square client geometry is also the Win10 fallback. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="Root" UseLayoutRounding="True" SnapsToDevicePixels="True" TextElement.Foreground="{StaticResource Ink}" CornerRadius="0" BorderThickness="1" BorderBrush="{StaticResource Stroke}" Padding="{StaticResource WindowPadding}" MouseLeftButtonDown="DragEmptyArea">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#262931" Offset="0"/>
        <GradientStop Color="#202228" Offset="0.7"/>
      </LinearGradientBrush>
    </Border.Background>
    <StackPanel>
      <Grid Height="28" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>
        <Border Width="24" Height="24" CornerRadius="6" Background="#0E0F12">
          <Grid Tag="overlay">
            <TextBlock Text="REC" Foreground="White" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Height="6" VerticalAlignment="Bottom" CornerRadius="0,0,6,6">
              <Border.Background>
                <LinearGradientBrush>
                  <GradientStop Color="#F6B73C" Offset="0"/>
                  <GradientStop Color="#E2452B" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </Border>
        <TextBlock Foreground="{StaticResource Ink}" Grid.Column="2" Text="庄Sir采访录制助手" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="3" Style="{StaticResource CloseButton}" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" Click="CloseClick">
          <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="14"/>
        </Button>
      </Grid>
      <StackPanel Margin="0,0,0,12">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="7" Height="7">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Mint}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding StatusTone}" Value="Busy">
                    <Setter Property="Fill" Value="{StaticResource Warn}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding StatusTone}" Value="Recording">
                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                    <Setter Property="Effect">
                      <Setter.Value>
                        <DropShadowEffect Color="#EF6A3A" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Foreground="{StaticResource Ink}" Grid.Column="2" Text="{Binding Phase}" FontSize="15" FontWeight="SemiBold"/>
          <Border Grid.Column="3" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="99"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Stealth}" Value="False">
                    <Setter Property="BorderBrush" Value="#59F0A640"/>
                    <Setter Property="Padding" Value="6,1"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding Chip}" FontSize="11">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Stealth}" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </Grid>
        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17.4" MaxHeight="34.8"/>
      </StackPanel>
      <Grid Margin="0,0,0,12" Visibility="{Binding HasTimecode, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Timecode}" FontFamily="{StaticResource MonoFont}" FontSize="28" FontWeight="Medium">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource Muted}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding ClockHint}" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
      </Grid>
      <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="3" Margin="0,0,0,12">
        <Grid IsEnabled="{Binding CanChange}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <RadioButton Style="{StaticResource Segment}" Content="摄像头" IsChecked="{Binding CameraSelected, Mode=OneWay}" Tag="camera" Click="ModeClick"/>
          <RadioButton Grid.Column="2" Style="{StaticResource Segment}" Content="桌面" IsChecked="{Binding DesktopSelected, Mode=OneWay}" Tag="desktop" Click="ModeClick"/>
          <RadioButton Grid.Column="4" Style="{StaticResource Segment}" Content="摄像头+桌面" IsChecked="{Binding BothSelected, Mode=OneWay}" Tag="both" Click="ModeClick"/>
        </Grid>
      </Border>
      <Grid Height="18" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="PreviewToggle" Style="{StaticResource Link}" Foreground="{StaticResource Muted}" FontSize="11.5" Click="TogglePreviewClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Style="{StaticResource Icon}" FontSize="14" Text="{Binding Chevron}" Margin="0,0,6,0"/>
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Text="{Binding Disclosure}"/>
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding PreviewState}" Foreground="{StaticResource Faint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid x:Name="PreviewRow" Margin="0,0,0,12" Visibility="{Binding PreviewVisible, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding CameraColumn}"/>
          <ColumnDefinition Width="{Binding TileGap}"/>
          <ColumnDefinition Width="{Binding DesktopColumn}"/>
        </Grid.ColumnDefinitions>
        <local:PreviewTile x:Name="CameraTile" Caption="摄像头 · 话筒" Image="{Binding CameraImage}" EmptyText="{Binding CameraMessage}" ShowRetry="{Binding CameraRetry}" ShowMeter="{Binding CameraAvailable}" Level="{Binding MicLevel}" Recording="{Binding IsRecording}" Ratio="{Binding PreviewRatio}" Visibility="{Binding IncludesCamera, Converter={StaticResource Visible}}" RetryRequested="RetryCamera"/>
        <local:PreviewTile x:Name="DesktopTile" Grid.Column="2" Glyph="&#xE7F4;" EmptyGlyph="&#xE7F4;" Image="{Binding DesktopImage}" Ratio="{Binding PreviewRatio}" Recording="{Binding IsRecording}" Visibility="{Binding IncludesDesktop, Converter={StaticResource Visible}}"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Primary}" IsEnabled="{Binding ActionEnabled}" AutomationProperties.Name="{Binding ActionText}" Click="RecordClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Style="{StaticResource Icon}" Text="{Binding ActionGlyph}" Margin="0,0,8,0"/>
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Text="{Binding ActionText}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="打开素材目录" AutomationProperties.Name="打开素材目录" Click="FolderClick">
          <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Text="&#xE8B7;" Style="{StaticResource Icon}"/>
        </Button>
        <Button Grid.Column="4" Style="{StaticResource IconButton}" IsEnabled="{Binding CanChange}" ToolTip="录制设置" AutomationProperties.Name="录制设置" Click="SettingsClick">
          <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Text="&#xE9E9;" Style="{StaticResource Icon}"/>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</Window>
