<?xml version="1.0" encoding="UTF-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ZSirCapture" x:Class="ZSirCapture.PreviewTile" x:Name="Tile" Focusable="False">
  <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph, ElementName=Tile}" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
      <TextBlock Text="{Binding Caption, ElementName=Tile}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <local:AspectBorder x:Name="Picture" Ratio="{Binding Ratio, ElementName=Tile}" CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
      <Grid Tag="overlay">
        <Image x:Name="PictureImage" Visibility="Collapsed" Source="{Binding Image, ElementName=Tile}" Stretch="UniformToFill" ClipToBounds="True" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
          <TextBlock Text="{Binding EmptyGlyph, ElementName=Tile}" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource Faint}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding EmptyText, ElementName=Tile}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Faint}" FontSize="11.5" MaxHeight="28" LineHeight="14" ToolTip="{Binding EmptyText, ElementName=Tile}"/>
          <Button x:Name="Retry" Content="重新检测" Style="{StaticResource Link}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" Click="RetryClick" Visibility="{Binding ShowRetry, ElementName=Tile, Converter={StaticResource Visible}}"/>
        </StackPanel>
        <Border Background="#73000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="{Binding Recording, ElementName=Tile, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,0,4,0"/>
            <TextBlock Text="REC" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border x:Name="MicMeter" Visibility="Collapsed" Width="4" Height="26" CornerRadius="2" Background="#66000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
          <Grid>
            <Border Background="{StaticResource Mint}" VerticalAlignment="Bottom" Height="{Binding MeterHeight, ElementName=Tile}"/>
          </Grid>
        </Border>
      </Grid>
    </local:AspectBorder>
  </StackPanel>
</UserControl>
